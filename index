<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Family Invitation & Headcount Tracker</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <!-- Firebase SDKs (CDN Compat Mode) -->
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen">
  <div class="max-w-7xl mx-auto p-4 md:p-8">
    
    <!-- Header -->
    <header class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
          <i class="fa-solid fa-users text-indigo-600"></i> Event Invitation & Guest Tracker
        </h1>
        <p class="text-slate-500 text-sm mt-1">Live cloud sync with Firestore • Gents, Ladies & Kids Breakdown</p>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="exportCSV()" class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2.5 rounded-lg shadow-sm transition">
          <i class="fa-solid fa-file-csv"></i> Export to CSV
        </button>
        <button onclick="window.print()" class="inline-flex items-center gap-2 bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium px-4 py-2.5 rounded-lg shadow-sm transition">
          <i class="fa-solid fa-print"></i> Print Summary
        </button>
      </div>
    </header>

    <!-- Summary Metrics Dashboard -->
    <section class="grid grid-cols-2 md:grid-cols-6 gap-3 md:gap-4 mb-8">
      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Families</p>
        <p id="totalFamilies" class="text-2xl font-bold text-slate-800 mt-1">0</p>
      </div>
      <div class="bg-white p-4 rounded-xl border border-blue-100 shadow-sm bg-blue-50/30">
        <p class="text-xs font-semibold uppercase tracking-wider text-blue-600">Total Gents</p>
        <p id="totalGents" class="text-2xl font-bold text-blue-700 mt-1">0</p>
      </div>
      <div class="bg-white p-4 rounded-xl border border-pink-100 shadow-sm bg-pink-50/30">
        <p class="text-xs font-semibold uppercase tracking-wider text-pink-600">Total Ladies</p>
        <p id="totalLadies" class="text-2xl font-bold text-pink-700 mt-1">0</p>
      </div>
      <div class="bg-white p-4 rounded-xl border border-amber-100 shadow-sm bg-amber-50/30">
        <p class="text-xs font-semibold uppercase tracking-wider text-amber-600">Total Kids</p>
        <p id="totalKids" class="text-2xl font-bold text-amber-700 mt-1">0</p>
      </div>
      <div class="bg-white p-4 rounded-xl border border-purple-100 shadow-sm bg-purple-50/30">
        <p class="text-xs font-semibold uppercase tracking-wider text-purple-600">Total Headcount</p>
        <p id="totalHeadcount" class="text-2xl font-bold text-purple-700 mt-1">0</p>
      </div>
      <div class="bg-white p-4 rounded-xl border border-emerald-100 shadow-sm bg-emerald-50/30">
        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Confirmed Coming</p>
        <p id="totalAttending" class="text-2xl font-bold text-emerald-700 mt-1">0</p>
      </div>
    </section>

    <!-- Main Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Input Form -->
      <section class="lg:col-span-4 bg-white p-6 rounded-xl border border-slate-200 shadow-sm h-fit">
        <h2 id="formTitle" class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
          <i class="fa-solid fa-user-plus text-indigo-600"></i> Add Family / Group
        </h2>
        <form id="familyForm" onsubmit="handleFormSubmit(event)" class="space-y-4">
          <input type="hidden" id="docId" value="" />
          
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Family / Head Name *</label>
            <input type="text" id="familyName" required placeholder="e.g. Ramesh Sharma & Family" class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">City / Location</label>
              <input type="text" id="city" placeholder="e.g. Hyderabad" class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Phone Number</label>
              <input type="tel" id="phone" placeholder="e.g. 9876543210" class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Gents</label>
              <input type="number" id="gentsCount" min="0" value="1" required class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Ladies</label>
              <input type="number" id="ladiesCount" min="0" value="1" required class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Kids</label>
              <input type="number" id="kidsCount" min="0" value="0" required class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">RSVP / Attendance Status</label>
            <select id="status" class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
              <option value="Attending">Coming (Confirmed)</option>
              <option value="Tentative">Tentative / Maybe</option>
              <option value="Invited">Invited (Awaiting Response)</option>
              <option value="Declined">Not Coming</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Notes / Remarks</label>
            <input type="text" id="notes" placeholder="e.g. Coming on 20th morning" class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
          </div>

          <div class="flex gap-2 pt-2">
            <button type="submit" id="saveBtn" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold py-2.5 rounded-lg shadow-sm transition">
              Add Family
            </button>
            <button type="button" id="cancelBtn" onclick="resetForm()" class="hidden px-4 bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm font-semibold py-2.5 rounded-lg transition">
              Cancel
            </button>
          </div>
        </form>
      </section>

      <!-- Table Section -->
      <section class="lg:col-span-8 bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
            <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <i class="fa-solid fa-list-check text-indigo-600"></i> Family Guest List
            </h2>
            <div class="flex gap-2">
              <input type="text" id="searchInput" oninput="renderTable()" placeholder="Search by name/city..." class="px-3 py-1.5 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
              <select id="filterStatus" onchange="renderTable()" class="px-3 py-1.5 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                <option value="All">All Statuses</option>
                <option value="Attending">Coming</option>
                <option value="Tentative">Tentative</option>
                <option value="Invited">Invited</option>
                <option value="Declined">Declined</option>
              </select>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm border-collapse">
              <thead>
                <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 text-xs font-semibold uppercase">
                  <th class="py-3 px-3">Family & City</th>
                  <th class="py-3 px-2 text-center text-blue-600">G</th>
                  <th class="py-3 px-2 text-center text-pink-600">L</th>
                  <th class="py-3 px-2 text-center text-amber-600">K</th>
                  <th class="py-3 px-2 text-center font-bold">Total</th>
                  <th class="py-3 px-3">Status</th>
                  <th class="py-3 px-3 text-right">Actions</th>
                </tr>
              </thead>
              <tbody id="familyTableBody" class="divide-y divide-slate-100"></tbody>
            </table>
          </div>
        </div>

        <p id="emptyMessage" class="hidden text-center py-8 text-slate-400 text-sm">
          No family entries found.
        </p>
      </section>

    </div>
  </div>

  <script>
    const firebaseConfig = {
      apiKey: "AIzaSyDbMtnm-PXJfs1ZEobc-lxu7T1yjFSjtUg",
      authDomain: "familycount-c6860.firebaseapp.com",
      databaseURL: "https://familycount-c6860-default-rtdb.asia-southeast1.firebasedatabase.app",
      projectId: "familycount-c6860",
      storageBucket: "familycount-c6860.firebasestorage.app",
      messagingSenderId: "206416370169",
      appId: "1:206416370169:web:27e5cf09964244326cc528",
      measurementId: "G-13PFL67Q6B"
    };

    firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();
    const collectionRef = db.collection("family_count");

    let families = [];

    // Real-time Firestore sync
    collectionRef.onSnapshot((snapshot) => {
      families = [];
      snapshot.forEach((doc) => {
        families.push({ id: doc.id, ...doc.data() });
      });
      renderDashboard();
      renderTable();
    });

    async function handleFormSubmit(e) {
      e.preventDefault();
      const docId = document.getElementById('docId').value;
      
      const record = {
        name: document.getElementById('familyName').value.trim(),
        city: document.getElementById('city').value.trim(),
        phone: document.getElementById('phone').value.trim(),
        gents: parseInt(document.getElementById('gentsCount').value) || 0,
        ladies: parseInt(document.getElementById('ladiesCount').value) || 0,
        kids: parseInt(document.getElementById('kidsCount').value) || 0,
        status: document.getElementById('status').value,
        notes: document.getElementById('notes').value.trim(),
        updatedAt: firebase.firestore.FieldValue.serverTimestamp()
      };

      if (docId) {
        await collectionRef.doc(docId).update(record);
      } else {
        await collectionRef.add(record);
      }

      resetForm();
    }

    function editEntry(id) {
      const item = families.find(f => f.id === id);
      if (!item) return;

      document.getElementById('docId').value = item.id;
      document.getElementById('familyName').value = item.name;
      document.getElementById('city').value = item.city || '';
      document.getElementById('phone').value = item.phone || '';
      document.getElementById('gentsCount').value = item.gents;
      document.getElementById('ladiesCount').value = item.ladies;
      document.getElementById('kidsCount').value = item.kids;
      document.getElementById('status').value = item.status;
      document.getElementById('notes').value = item.notes || '';

      document.getElementById('formTitle').innerHTML = `<i class="fa-solid fa-pen-to-square text-indigo-600"></i> Edit Family`;
      document.getElementById('saveBtn').textContent = 'Update Entry';
      document.getElementById('cancelBtn').classList.remove('hidden');
    }

    async function deleteEntry(id) {
      const item = families.find(f => f.id === id);
      if (confirm(`Remove ${item ? item.name : 'this entry'}?`)) {
        await collectionRef.doc(id).delete();
      }
    }

    function resetForm() {
      document.getElementById('familyForm').reset();
      document.getElementById('docId').value = '';
      document.getElementById('gentsCount').value = 1;
      document.getElementById('ladiesCount').value = 1;
      document.getElementById('kidsCount').value = 0;
      document.getElementById('formTitle').innerHTML = `<i class="fa-solid fa-user-plus text-indigo-600"></i> Add Family / Group`;
      document.getElementById('saveBtn').textContent = 'Add Family';
      document.getElementById('cancelBtn').classList.add('hidden');
    }

    function renderDashboard() {
      let gents = 0, ladies = 0, kids = 0, attendingCount = 0;

      families.forEach(f => {
        gents += f.gents || 0;
        ladies += f.ladies || 0;
        kids += f.kids || 0;
        if (f.status === 'Attending') {
          attendingCount += ((f.gents || 0) + (f.ladies || 0) + (f.kids || 0));
        }
      });

      document.getElementById('totalFamilies').textContent = families.length;
      document.getElementById('totalGents').textContent = gents;
      document.getElementById('totalLadies').textContent = ladies;
      document.getElementById('totalKids').textContent = kids;
      document.getElementById('totalHeadcount').textContent = gents + ladies + kids;
      document.getElementById('totalAttending').textContent = attendingCount;
    }

    function getStatusBadge(status) {
      switch (status) {
        case 'Attending':
          return `<span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full text-xs font-semibold">Coming</span>`;
        case 'Tentative':
          return `<span class="bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full text-xs font-semibold">Tentative</span>`;
        case 'Declined':
          return `<span class="bg-rose-100 text-rose-800 px-2 py-0.5 rounded-full text-xs font-semibold">Declined</span>`;
        default:
          return `<span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded-full text-xs font-semibold">Invited</span>`;
      }
    }

    function renderTable() {
      const tbody = document.getElementById('familyTableBody');
      const search = document.getElementById('searchInput').value.toLowerCase();
      const statusFilter = document.getElementById('filterStatus').value;
      tbody.innerHTML = '';

      const filtered = families.filter(f => {
        const matchesSearch = (f.name && f.name.toLowerCase().includes(search)) || (f.city && f.city.toLowerCase().includes(search));
        const matchesStatus = (statusFilter === 'All') || (f.status === statusFilter);
        return matchesSearch && matchesStatus;
      });

      if (filtered.length === 0) {
        document.getElementById('emptyMessage').classList.remove('hidden');
      } else {
        document.getElementById('emptyMessage').classList.add('hidden');
      }

      filtered.forEach(item => {
        const total = (item.gents || 0) + (item.ladies || 0) + (item.kids || 0);
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50 transition';
        tr.innerHTML = `
          <td class="py-3 px-3">
            <div class="font-semibold text-slate-900">${item.name}</div>
            <div class="text-xs text-slate-400">${item.city ? item.city : 'No location'} ${item.phone ? '• ' + item.phone : ''}</div>
            ${item.notes ? `<div class="text-xs text-indigo-600 mt-0.5 italic">Note: ${item.notes}</div>` : ''}
          </td>
          <td class="py-3 px-2 text-center font-medium text-slate-700">${item.gents}</td>
          <td class="py-3 px-2 text-center font-medium text-slate-700">${item.ladies}</td>
          <td class="py-3 px-2 text-center font-medium text-slate-700">${item.kids}</td>
          <td class="py-3 px-2 text-center font-bold text-slate-900">${total}</td>
          <td class="py-3 px-3">${getStatusBadge(item.status)}</td>
          <td class="py-3 px-3 text-right">
            <button onclick="editEntry('${item.id}')" class="text-slate-500 hover:text-indigo-600 p-1 mx-1" title="Edit">
              <i class="fa-solid fa-pen"></i>
            </button>
            <button onclick="deleteEntry('${item.id}')" class="text-slate-500 hover:text-rose-600 p-1 mx-1" title="Delete">
              <i class="fa-solid fa-trash"></i>
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function exportCSV() {
      if (families.length === 0) {
        alert('No records to export!');
        return;
      }
      const headers = ['Family Name', 'City', 'Phone', 'Gents', 'Ladies', 'Kids', 'Total Headcount', 'Status', 'Notes'];
      const rows = families.map(f => [
        `"${f.name}"`,
        `"${f.city || ''}"`,
        `"${f.phone || ''}"`,
        f.gents,
        f.ladies,
        f.kids,
        (f.gents || 0) + (f.ladies || 0) + (f.kids || 0),
        `"${f.status}"`,
        `"${f.notes || ''}"`
      ]);

      const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement('a');
      link.setAttribute('href', encodedUri);
      link.setAttribute('download', 'Family_Invitation_Summary.csv');
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
  </script>
</body>
</html>
